[Unit]
Description=ARGUS weekly report (Q-H3: the figures of the last complete Monday-to-Sunday UTC week, and of any other week of the last 4 that a missed run left out; custody layout, Q-A5)
# Started by argus-report-weekly.timer. Reads the local database only (no SIEM request, no model call) and
# stores the report once. Off until the user has read two reports.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=argus-svc
Group=argus-svc
SupplementaryGroups=argus
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=svc
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=database.password:/etc/argus/credentials/database.password
LoadCredential=siem.api_key:/etc/argus/credentials/siem.api_key
LoadCredential=llm-api-keys.env:/etc/argus/credentials/llm-api-keys.env
ExecStart=/opt/argus/current/.venv/bin/argus report weekly
MemoryMax=512M
TimeoutStartSec=10min
Nice=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
