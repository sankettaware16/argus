[Unit]
Description=ARGUS notices: a link, a severity and a count by e-mail (custody layout)
# Started by argus-notices.timer. Sends mail only when notices.enabled is true, a recipient is
# named and the relay is set (docs/runbooks/notices.md). A relay that needs a login names
# notices.password in this unit at that production step (it is not loaded until then).
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=argus-svc
Group=argus-svc
SupplementaryGroups=argus
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=svc
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=database.password:/etc/argus/credentials/database.password
LoadCredential=siem.api_key:/etc/argus/credentials/siem.api_key
LoadCredential=llm-api-keys.env:/etc/argus/credentials/llm-api-keys.env
ExecStart=/opt/argus/current/.venv/bin/argus notices run
MemoryMax=512M
TimeoutStartSec=10min
Nice=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
