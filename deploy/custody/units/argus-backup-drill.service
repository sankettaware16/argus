[Unit]
Description=ARGUS weekly restore drill of the newest nightly dump (custody layout)
# Started by argus-backup-drill.timer. Restores into a scratch database, compares every
# table's fingerprint with the dump's own, drops the scratch database. Its memory cap is its own
# (the operator's heavy-task lock lives in the operator's home, which root's units do not see).
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=owner
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=database.owner_password:/etc/argus/credentials/database.owner_password
ExecStart=/opt/argus/current/.venv/bin/argus backup drill --latest
MemoryMax=2G
Nice=10
ReadWritePaths=/var/lib/argus-backups
Environment=DOCKER_CONTEXT=default
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
