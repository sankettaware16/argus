[Unit]
Description=ARGUS writer: Kibana case and alert writes from the outbox (custody layout)
# Disabled: writes need the user's approval of each class at its canary (plan §7.1, D-109).
# The writer key is loaded by this unit alone (plan §3 rule 11); its credential file is made at
# the canary, so until then a start fails. Until its command exists the condition below skips a
# start instead of failing it again and again. Only the keys the cases schedule needs are loaded:
# a missing credential file fails LoadCredential= and the whole unit, so the keys minted at later
# canaries (siem.writer_api_key for R17's write-back, kibana.alert_writer_api_key for Q-D5) are
# not named here; the unit of the step that uses a key names it once the key exists.
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=argus-writer
Group=argus-writer
SupplementaryGroups=argus
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=writer
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=database.writer_password:/etc/argus/credentials/database.writer_password
LoadCredential=approval-signing.key:/etc/argus/credentials/approval-signing.key
LoadCredential=siem.api_key:/etc/argus/credentials/siem.api_key
LoadCredential=kibana.reader_api_key:/etc/argus/credentials/kibana.reader_api_key
LoadCredential=kibana.cases_writer_api_key:/etc/argus/credentials/kibana.cases_writer_api_key
ExecCondition=/opt/argus/current/.venv/bin/argus writer --help
ExecStart=/opt/argus/current/.venv/bin/argus writer run
Restart=on-failure
RestartSec=60
MemoryMax=512M
Nice=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
