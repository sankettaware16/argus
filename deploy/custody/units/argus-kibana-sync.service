[Unit]
Description=ARGUS Kibana sync: read-back and reconciliation (custody layout)
# Disabled: enabled at its production step (Q-D3's first live read, with the user). Until its
# command exists the condition below skips a start instead of failing it again and again.
# Restart=on-failure: `sync run` exits 0 while kibana.enabled or kibana.sync.enabled is false,
# so an enabled unit of an off read-back stays stopped (it does not start again every 30 s).
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=argus-svc
Group=argus-svc
SupplementaryGroups=argus
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=svc
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=database.password:/etc/argus/credentials/database.password
LoadCredential=siem.api_key:/etc/argus/credentials/siem.api_key
LoadCredential=llm-api-keys.env:/etc/argus/credentials/llm-api-keys.env
LoadCredential=kibana.reader_api_key:/etc/argus/credentials/kibana.reader_api_key
ExecCondition=/opt/argus/current/.venv/bin/argus kibana sync --help
ExecStart=/opt/argus/current/.venv/bin/argus kibana sync run
Restart=on-failure
RestartSec=30
MemoryMax=512M
Nice=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
