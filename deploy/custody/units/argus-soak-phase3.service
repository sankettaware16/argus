[Unit]
Description=ARGUS soak gate (P4-A1: the Phase 3 exit gate judged from the store and saved under soak.dir; custody layout, Q-A5)
# Started by argus-soak-phase3.timer. Reads the local database and a few local files only (no
# request to the SIEM, no model call); writes its report to its own state folder. Off until the
# lead switches it on.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=argus-svc
Group=argus-svc
SupplementaryGroups=argus
WorkingDirectory=/opt/argus/current
EnvironmentFile=/etc/argus/argus.env
Environment=ARGUS_CUSTODY__ROLE=svc
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ARGUS_SOAK__DIR=/var/lib/argus-soak
LoadCredential=database.password:/etc/argus/credentials/database.password
LoadCredential=siem.api_key:/etc/argus/credentials/siem.api_key
LoadCredential=llm-api-keys.env:/etc/argus/credentials/llm-api-keys.env
ExecStart=/opt/argus/current/.venv/bin/argus soak phase3 --write
MemoryMax=512M
TimeoutStartSec=10min
Nice=10
UMask=0077
StateDirectory=argus-soak
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
