[Unit]
Description=ARGUS soak gate: the exit gate judged from the store and saved under soak.dir
# Started by argus-soak-phase3.timer. Reads ARGUS's own database and a few local files only (no
# request to the SIEM, no model call, nothing written but the report). Exit 1 means a line FAILs:
# the report is saved first. Off until the lead switches it on (docs/runbooks/soak-gate.md).

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@UV@ run argus soak phase3 --write
MemoryMax=512M
TimeoutStartSec=10min
Nice=10
