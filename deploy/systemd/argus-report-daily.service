[Unit]
Description=ARGUS daily report: the figures of the last UTC day that has ended, and of any other day of the last 7 that a missed run left out, from ARGUS's own database
# Started by argus-report-daily.timer. Reads the local database only (no SIEM request, no model call), stores
# the report once (a period already made is left as it is) and audits it. Off until the user has
# read two reports (docs/gates/q-h3.md, production steps).

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@UV@ run argus report daily
MemoryMax=512M
TimeoutStartSec=10min
Nice=10
