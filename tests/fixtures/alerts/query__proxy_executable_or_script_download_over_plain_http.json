    "kibana.alert.rule.created_at": "2026-10-05T09:23:29.786Z",
    "kibana.alert.rule.created_by": "elastic",
    "kibana.alert.rule.description": "Detects a successful (200/206) GET over unencrypted HTTP where the URL ends in an executable or script extension (exe, dll, ps1, bat, cmd, vbs, hta, scr, msi, jar). Windows Update / Delivery Optimization traffic, which produces most such downloads (via msdownload / filestreamingservice paths and Microsoft ASNs), is excluded. Plain-HTTP binaries are a common malware delivery and tool-transfer channel and can be tampered with in transit. Baseline on 2026-10-05: ~3 matching events per 10 minutes after exclusions.",
    "kibana.alert.rule.enabled": true,
    "kibana.alert.rule.exceptions_list": [],
    "kibana.alert.rule.execution.timestamp": "2026-10-09T11:04:52.728Z",
    "kibana.alert.rule.execution.type": "scheduled",
    "kibana.alert.rule.execution.uuid": "bdc6b9f3-ce50-898b-ca16-c0e5d3246d75",
    "kibana.alert.rule.false_positives": [],
    "kibana.alert.rule.from": "now-6m",
    "kibana.alert.rule.immutable": false,
    "kibana.alert.rule.indices": [
      "acme-logs-squid*"
    ],
    "kibana.alert.rule.interval": "5m",
    "kibana.alert.rule.license": "",
    "kibana.alert.rule.max_signals": 100,
    "kibana.alert.rule.meta.created_from": "CC_Report_Writer proxy baseline 2026-10-05",
    "kibana.alert.rule.name": "Proxy: Executable or Script Download over Plain HTTP",
    "kibana.alert.rule.note": "### Investigation Steps\n1. Review `url.original` and `destination.domain` / `destination.ip`. Is it a known vendor download site (e.g. software-dl.ti.com, dl.google.com) or an unknown IP/host?\n2. Check `destination.as.organization.name`, `destination.geo.country_name`, and whether the same URL was fetched by many hosts (patching) or one host (targeted).\n3. If the file came from a raw IP or a recently registered domain, obtain the file hash from the endpoint and check VirusTotal.\n4. `http.response.status_code: 206` with many requests = resumable download, normal for updaters.\n\n### False positives\nSoftware updaters that still use HTTP (TI Code Composer, some Linux repos, Java tooling). Add trusted domains to the exception list.",
    "kibana.alert.rule.parameters": {
      "alert_suppression": {
        "duration": {
          "unit": "h",
          "value": 6
        },
        "group_by": [
          "source.ip",
