    "kibana.alert.rule.created_at": "2026-10-05T09:26:15.998Z",
    "kibana.alert.rule.created_by": "elastic",
    "kibana.alert.rule.description": "Detects a successful CONNECT tunnel through the Squid proxy to a destination port used for remote administration (SSH 22, Telnet 23, RDP 3389, VNC 5900/5901, WinRM 5985/5986, SMB 445/135/139), common backdoor/anonymiser ports (4444, 1080 SOCKS, Tor 9001/9050) or IRC (6667/6697). The web proxy should normally only tunnel HTTPS (443); tunnelling other protocols over CONNECT is a classic way to bypass egress controls. Baseline on 2026-10-05: ~90 internal hosts/day use SSH over the proxy, nothing on the other ports.",
    "kibana.alert.rule.enabled": true,
    "kibana.alert.rule.exceptions_list": [],
    "kibana.alert.rule.execution.timestamp": "2026-10-09T12:22:47.772Z",
