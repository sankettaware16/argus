    "kibana.alert.rule.name": "Sensitive Path Enumeration",
    "kibana.alert.rule.note": "### Investigation Steps\n1. **Review Targets:** Look at the `url.path` list. Since the CC app is custom, attempts to access `wp-admin` indicate a generic \"spray and pray\" attack rather than a targeted intrusion.\n2. **Check for Success:** Filter the index for this `source.ip` and check if any requests returned a `200 OK`. \n3. **Action:** These are highly noisy events. Use this alert primarily for intelligence gathering to feed automated IP blocking systems rather than manual escalation, unless a `200 OK` is observed.",
    "kibana.alert.rule.parameters": {
      "author": [],
      "description": "Detects repeated attempts from a single IP to access common administrative, configuration, or sensitive repository paths.",
      "exceptions_list": [],
      "false_positives": [
        "Internal vulnerability scanners (if not excluded); poorly configured internal monitoring tools."
      ],
      "from": "now-6m",
      "immutable": false,
      "investigation_fields": {
        "field_names": [
          "source.ip",
          "url.path",
          "hits"
        ]
      },
      "language": "esql",
      "license": "",
      "max_signals": 100,
      "meta": {
        "kibana_siem_app_url": "https://10.122.252.228:5601/s/acme-univcc/app/security"
      },
      "note": "### Investigation Steps\n1. **Review Targets:** Look at the `url.path` list. Since the CC app is custom, attempts to access `wp-admin` indicate a generic \"spray and pray\" attack rather than a targeted intrusion.\n2. **Check for Success:** Filter the index for this `source.ip` and check if any requests returned a `200 OK`. \n3. **Action:** These are highly noisy events. Use this alert primarily for intelligence gathering to feed automated IP blocking systems rather than manual escalation, unless a `200 OK` is observed.",
      "query": "FROM acme-logs-nginx-*\n| WHERE url.path RLIKE \".*(wp-admin|wp-login|phpmyadmin|xmlrpc|\\\\.git|\\\\.env).*\"\n| STATS\n    hits = COUNT(),\n    unique_sensitive_paths = COUNT_DISTINCT(url.path),\n    attempted_paths = VALUES(url.path),\n    methods = VALUES(http.request.method),\n    statuses = VALUES(http.response.status_code)\nBY source.ip,\n   source.geo.country_name,\n   user_agent.original\n| WHERE\n    hits >= 10\n    OR unique_sensitive_paths >= 3",
