# Copy to .env and fill in. .env is gitignored — never commit real values.
# Nested settings use "__": ARGUS_<SECTION>__<KEY>.

# --- Local Postgres (docker compose service "db") ---
# Schema owner (D-029): the container's superuser; only `argus db ...` logs in as it.
ARGUS_DATABASE__OWNER_USER=argus
ARGUS_DATABASE__OWNER_PASSWORD=change-me
# Runtime role ARGUS runs as; `argus db bootstrap` creates it with this password.
ARGUS_DATABASE__USER=argus_app
ARGUS_DATABASE__PASSWORD=change-me-too
ARGUS_DATABASE__NAME=argus
ARGUS_DATABASE__HOST=127.0.0.1
ARGUS_DATABASE__PORT=55432
# The web's own login (Q-A2): `argus db bootstrap` makes argus_api with this password; the web
# uses it once config/argus.yaml says web: database_role: api (docs/runbooks/platform.md).
# ARGUS_DATABASE__API_PASSWORD=

# --- the SIEM (the read-only argus_reader key, D-048; record its expiry: siem.api_key_expires) ---
# ARGUS_SIEM__API_KEY=
# Never a writer key here: it belongs only to the writer's own credential (Q-A5), and doctor
# fails while one is in this file.

# --- Local Elasticsearch replica (docker compose --profile replica) ---
REPLICA_ELASTIC_PASSWORD=change-me

# --- Outside threat intel (AR3, D-165): one key per source, your own free personal ones ---
# A source without a key is off. VirusTotal: reputation of public addresses and names;
# Shodan and Censys: what a public server is (host lookups only). Censys's is a Platform
# personal access token (the old API id and secret no longer work).
# ARGUS_OUTSIDE__VIRUSTOTAL_API_KEY=
# ARGUS_OUTSIDE__SHODAN_API_KEY=
# ARGUS_OUTSIDE__CENSYS_API_KEY=
